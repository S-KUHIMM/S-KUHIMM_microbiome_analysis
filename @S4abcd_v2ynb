    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from scipy.stats import pearsonr\n",
    "import statsmodels.stats.multitest as multitest\n",
    "import warnings\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# ==========================================\n",
    "# 1. Global Page and Font Settings\n",
    "# ==========================================\n",
    "plt.rcParams['font.family'] = 'sans-serif'\n",
    "plt.rcParams['font.sans-serif'] = ['Arial', 'Helvetica', 'DejaVu Sans']\n",
    "plt.rcParams['font.weight'] = 'normal'\n",
    "plt.rcParams['axes.labelweight'] = 'bold'\n",
    "plt.rcParams['axes.titleweight'] = 'bold'\n",
    "plt.rcParams['axes.linewidth'] = 1.5\n",
    "plt.rcParams['pdf.fonttype'] = 42\n",
    "plt.rcParams['ps.fonttype'] = 42\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Mathtext configuration for independent styling:\n",
    "# - \\mathit{} maps to regular Italic (for r and q)\n",
    "# - \\mathtt{} is remapped to Bold Italic (for Genus)\n",
    "# - \\mathbf{} maps to regular Bold (for spp.)\n",
    "# ---------------------------------------------------------\n",
    "plt.rcParams['mathtext.fontset'] = 'custom'\n",
    "plt.rcParams['mathtext.it'] = 'Arial:italic'\n",
    "plt.rcParams['mathtext.bf'] = 'Arial:bold'\n",
    "plt.rcParams['mathtext.tt'] = 'Arial:italic:bold'\n",
    "\n",
    "def clean_and_convert(vals):\n",
    "    s_vals = pd.Series(vals).astype(str).str.strip().replace(['Undetermined', '-', 'nan', 'NaN', '#VALUE!', ''], np.nan)\n",
    "    return pd.to_numeric(s_vals, errors='coerce')\n",
    "\n",
    "# ==========================================\n",
    "# 2. Data Loading & Preprocessing\n",
    "# ==========================================\n",
    "df_ace = pd.read_csv('Acetate(mM).csv')\n",
    "df_but = pd.read_csv('Butyrate(mM).csv')\n",
    "donor_cols = [c for c in df_ace.columns if c.startswith('HS-')]\n",
    "\n",
    "ctrl_ace = clean_and_convert(df_ace[df_ace.iloc[:, 0].astype(str).isin(['0', '000'])][donor_cols].iloc[0].values)\n",
    "inul_ace = clean_and_convert(df_ace[df_ace['KULFFI'] == 'Inulin'][donor_cols].iloc[0].values)\n",
    "delta_ace = inul_ace - ctrl_ace\n",
    "ctrl_but = clean_and_convert(df_but[df_but.iloc[:, 0].astype(str).isin(['0', '000'])][donor_cols].iloc[0].values)\n",
    "inul_but = clean_and_convert(df_but[df_but['KULFFI'] == 'Inulin'][donor_cols].iloc[0].values)\n",
    "delta_but = inul_but - ctrl_but\n",
    "\n",
    "df_16s = pd.read_csv('(KULFFI)_16S_Genus_level.csv')\n",
    "bac_cols = [c for c in df_16s.columns if str(c).startswith('d__Bacteria')]\n",
    "bifi_col = [c for c in df_16s.columns if 'g__Bifidobacterium' in c][0]\n",
    "fae_col = [c for c in df_16s.columns if 'g__Faecalibacterium' in c][0]\n",
    "\n",
    "donor_16s = {}\n",
    "for cluster in df_16s['Cluster'].unique():\n",
    "    df_cluster = df_16s[df_16s['Cluster'] == cluster]\n",
    "    row_fec = df_cluster[df_cluster['Feature'] == 'FEC']\n",
    "    if row_fec.empty:\n",
    "        continue\n",
    "    total_fec = row_fec[bac_cols].sum(axis=1).values[0]\n",
    "    bifi_fec = (row_fec[bifi_col].values[0] / total_fec) * 100 if total_fec > 0 else np.nan\n",
    "    fae_fec = (row_fec[fae_col].values[0] / total_fec) * 100 if total_fec > 0 else np.nan\n",
    "    row_ctrl = df_cluster[df_cluster['Feature'] == 'CUL']\n",
    "    row_inul = df_cluster[df_cluster['Feature'] == 'Inulin']\n",
    "\n",
    "    total_ctrl = row_ctrl[bac_cols].sum(axis=1).values[0] if not row_ctrl.empty else 0\n",
    "    total_inul = row_inul[bac_cols].sum(axis=1).values[0] if not row_inul.empty else 0\n",
    "\n",
    "    bifi_ctrl = (row_ctrl[bifi_col].values[0] / total_ctrl) * 100 if total_ctrl > 0 else np.nan\n",
    "    fae_ctrl = (row_ctrl[fae_col].values[0] / total_ctrl) * 100 if total_ctrl > 0 else np.nan\n",
    "    bifi_inul = (row_inul[bifi_col].values[0] / total_inul) * 100 if total_inul > 0 else np.nan\n",
    "    fae_inul = (row_inul[fae_col].values[0] / total_inul) * 100 if total_inul > 0 else np.nan\n",
    "\n",
    "    donor_16s[cluster] = {\n",
    "        'bifi_fec': bifi_fec, 'fae_fec': fae_fec,\n",
    "        'bifi_ctrl': bifi_ctrl, 'bifi_inul': bifi_inul, 'bifi_delta': bifi_inul - bifi_ctrl,\n",
    "        'fae_ctrl': fae_ctrl, 'fae_inul': fae_inul, 'fae_delta': fae_inul - fae_ctrl\n",
    "    }\n",
    "\n",
    "data = []\n",
    "for i, donor in enumerate(donor_cols):\n",
    "    if donor in donor_16s:\n",
    "        d_info = donor_16s[donor]\n",
    "        data.append({\n",
    "            'Delta_Acetate': delta_ace.iloc[i], 'Delta_Butyrate': delta_but.iloc[i],\n",
    "            'Bifi_Init': d_info['bifi_fec'], 'Bifi_Post': d_info['bifi_inul'], 'Bifi_Delta': d_info['bifi_delta'],\n",
    "            'Fae_Init': d_info['fae_fec'], 'Fae_Post': d_info['fae_inul'], 'Fae_Delta': d_info['fae_delta']\n",
    "        })\n",
    "df_final = pd.DataFrame(data)\n",
    "\n",
    "# ==========================================\n",
    "# 3. Statistical Testing (FDR Correction)\n",
    "# ==========================================\n",
    "plot_configs = [\n",
    "    ('Bifi_Init', r'Initial $\\mathtt{Bifidobacterium}$ $\\mathbf{spp.}$ (%)', 'Delta_Acetate', r'$\\Delta$ Acetate (mM)'),\n",
    "    ('Bifi_Post', r'Post $\\mathtt{Bifidobacterium}$ $\\mathbf{spp.}$ (%)', 'Delta_Acetate', ''),\n",
    "    ('Bifi_Delta', r'$\\Delta$ $\\mathtt{Bifidobacterium}$ $\\mathbf{spp.}$ (%)', 'Delta_Acetate', ''),\n",
    "    ('Bifi_Init', r'Initial $\\mathtt{Bifidobacterium}$ $\\mathbf{spp.}$ (%)', 'Delta_Butyrate', r'$\\Delta$ Butyrate (mM)'),\n",
    "    ('Bifi_Post', r'Post $\\mathtt{Bifidobacterium}$ $\\mathbf{spp.}$ (%)', 'Delta_Butyrate', ''),\n",
    "    ('Bifi_Delta', r'$\\Delta$ $\\mathtt{Bifidobacterium}$ $\\mathbf{spp.}$ (%)', 'Delta_Butyrate', ''),\n",
    "    ('Fae_Init', r'Initial $\\mathtt{Faecalibacterium}$ $\\mathbf{spp.}$ (%)', 'Delta_Acetate', r'$\\Delta$ Acetate (mM)'),\n",
    "    ('Fae_Post', r'Post $\\mathtt{Faecalibacterium}$ $\\mathbf{spp.}$ (%)', 'Delta_Acetate', ''),\n",
    "    ('Fae_Delta', r'$\\Delta$ $\\mathtt{Faecalibacterium}$ $\\mathbf{spp.}$ (%)', 'Delta_Acetate', ''),\n",
    "    ('Fae_Init', r'Initial $\\mathtt{Faecalibacterium}$ $\\mathbf{spp.}$ (%)', 'Delta_Butyrate', r'$\\Delta$ Butyrate (mM)'),\n",
    "    ('Fae_Post', r'Post $\\mathtt{Faecalibacterium}$ $\\mathbf{spp.}$ (%)', 'Delta_Butyrate', ''),\n",
    "    ('Fae_Delta', r'$\\Delta$ $\\mathtt{Faecalibacterium}$ $\\mathbf{spp.}$ (%)', 'Delta_Butyrate', '')\n",
    "]\n",
    "\n",
    "p_values = []\n",
    "valid_data_subsets = []\n",
    "for x_col, _, y_col, _ in plot_configs:\n",
    "    df_sub = df_final.dropna(subset=[x_col, y_col])\n",
    "    x_data, y_data = df_sub[x_col], df_sub[y_col]\n",
    "    r, p = pearsonr(x_data, y_data)\n",
    "    p_values.append(p)\n",
    "    valid_data_subsets.append((x_data, y_data, r))\n",
    "\n",
    "_, q_values, _, _ = multitest.multipletests(p_values, alpha=0.05, method='fdr_bh')\n",
    "\n",
    "# ==========================================\n",
    "# 4. Figure Generation\n",
    "# ==========================================\n",
    "fig, axes = plt.subplots(4, 3, figsize=(16, 20), dpi=600)\n",
    "color_inulin = '#8B008B'\n",
    "\n",
    "for i, (ax, config) in enumerate(zip(axes.flatten(), plot_configs)):\n",
    "    x_col, xlabel, y_col, ylabel = config\n",
    "    x_data, y_data, r = valid_data_subsets[i]\n",
    "    q = q_values[i]\n",
    "\n",
    "    line_color, line_alpha = ('black', 1.0) if abs(r) > 0.5 else ('#A0A0A0', 0.5)\n",
    "\n",
    "    sns.regplot(\n",
    "        x=x_data, y=y_data, ax=ax,\n",
    "        scatter_kws={'color': color_inulin, 'edgecolor': 'black', 's': 60, 'linewidths': 1, 'alpha': 0.8},\n",
    "        line_kws={'color': line_color, 'alpha': line_alpha, 'linewidth': 1.5}\n",
    "    )\n",
    "\n",
    "    q_str = \"< 0.001\" if q < 0.001 else f\"= {q:.3f}\"\n",
    "\n",
    "    ax.text(0.95, 0.95, f\"$\\mathit{{r}}$ = {r:.2f}\\n$\\mathit{{q}}$ {q_str}\",\n",
    "            transform=ax.transAxes, ha='right', va='top', fontsize=14, fontweight='normal')\n",
    "\n",
    "    ax.set_xlabel(xlabel, fontsize=14, fontweight='bold')\n",
    "    if ylabel: ax.set_ylabel(ylabel, fontsize=14, fontweight='bold')\n",
    "    else: ax.set_ylabel('')\n",
    "\n",
    "    ax.tick_params(axis='both', which='major', labelsize=12)\n",
    "    for s in ['top', 'right']: ax.spines[s].set_visible(False)\n",
    "    for s in ['left', 'bottom']: ax.spines[s].set_linewidth(1.5)\n",
    "    ax.set_box_aspect(1)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('Supplementary_Figure_S4abcd_InitialFEC.pdf', dpi=600, bbox_inches='tight', transparent=True)\n",
    "plt.show()"
   ]
  }
 ]
